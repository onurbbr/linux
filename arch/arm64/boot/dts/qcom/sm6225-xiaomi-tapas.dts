/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
#include "sm6225.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Xiaomi Redmi Note 12 4G";
	compatible = "xiaomi,tapas", "qcom,sm6225";
	chassis-type = "handset";

	/* required for bootloader to select correct board */
	qcom,msm-id = <518 0x10000>;
	qcom,board-id = <0x20022 0>;

	aliases {
		serial0 = &uart3;
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_n>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	chosen {
		bootargs = "console=tty0 pmos.nosplash";

		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			format = "a8b8g8r8";
			height = <0x960>;
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			status = "okay";
			stride = <0x10e0>;
			width = <0x438>;
		};
	};

	/* Touch AVDD load-switch enable (tlmm36, stock ts_avdd output-high) */
	touch_avdd: touch-avdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "touch-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	onewire_gpio: onewire-gpio {
		compatible = "xiaomi,onewire_gpio";
		label = "xm_onewire";
		xiaomi,version = <1>;
		xiaomi,ow-gpios = <&tlmm 108 GPIO_ACTIVE_HIGH>;
		xiaomi,gpio_number = <108>;
		mi,onewire-gpio-cfg-addr = <0x96c000 0x04>;
		pinctrl-names = "onewire_active", "onewire_sleep";
		pinctrl-0 = <&onewire_gpio_active>;
		pinctrl-1 = <&onewire_gpio_sleep>;
		status = "okay";
	};

	maxim_ds28e16: ds28e16 {
		compatible = "maxim,ds28e16";
		label = "max_ds28e16";
		maxim,version = <1>;
		status = "okay";
	};

	wcd9370: audio-codec {
		compatible = "qcom,wcd9370-codec";

		pinctrl-names = "default";
		pinctrl-0 = <&wcd_reset_n>;

		reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&pm6125_l14>;
		vdd-rxtx-supply = <&pm6125_l9>;
		vdd-px-supply = <&pm6125_l9>;

		qcom,micbias1-microvolt = <2700000>;
		qcom,micbias2-microvolt = <2800000>;
		qcom,micbias3-microvolt = <2700000>;

		qcom,rx-device = <&wcd937x_rx>;
		qcom,tx-device = <&wcd937x_tx>;

		#sound-dai-cells = <1>;
	};

	sound: sound {
		compatible = "xiaomi,tapas-sndcard";
		model = "Xiaomi-Redmi-Note-12-4G";
		audio-routing =
			"SpkrLeft IN", "AUX",
			"Speaker", "SpkrLeft OUT",
			"IN1_HPHL", "HPHL_OUT",
			"IN2_HPHR", "HPHR_OUT",
			"IN3_AUX", "AUX_OUT",
			"AMIC1", "MIC BIAS1",
			"AMIC2", "MIC BIAS2",
			"AMIC3", "MIC BIAS3",
			"VA SWR_MIC0", "ADC1_OUTPUT",
			"VA SWR_MIC4", "ADC2_OUTPUT",
			"VA SWR_MIC5", "ADC3_OUTPUT",
			"TX SWR_INPUT0", "ADC1_OUTPUT",
			"TX SWR_INPUT1", "ADC2_OUTPUT",
			"TX SWR_INPUT2", "ADC3_OUTPUT";

		aux-devs = <&aw87xxx>;

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			codec {
				sound-dai = <&wcd9370 0>, <&swr1 0>, <&rxmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			codec {
				sound-dai = <&wcd9370 1>, <&swr0 0>, <&txmacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <&q6apmbedai VA_CODEC_DMA_TX_0>;
			};

			codec {
				sound-dai = <&vamacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};
};

&adreno_smmu {
	status = "okay";
};

&gpu {
	status = "okay";

	zap-shader {
		firmware-name = "qcom/sm6225/XIAOMI/TAPAS/a610_zap.mdt";
	};
};

&gmu_wrapper {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	status = "okay";
	vdda-supply = <&pm6125_l18>;

	panel@0 {
		compatible = "xiaomi,m7-38-0c-0a";
		reg = <0>;

		vddio-supply = <&pm6125_l9>;

		/* Reset is active-high on TLMM 82, enable on PM6125 GPIO 9 */
		reset-gpios = <&tlmm 82 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&pm6125_gpios 9 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&te_active>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

&tlmm {
	te_active: te-active-state {
		pins = "gpio81";
		function = "mdp_vsync";
		bias-disable;
	};

	/* Stock base pinconf mirror (pmx_ts_*_active) */
	ts_int_active: ts-int-active-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_reset_active: ts-reset-active-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_avdd_active: ts-avdd-active-state {
		pins = "gpio36";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};

	sc8551_int_default: sc8551-int-default-state {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	onewire_gpio_active: onewire-gpio-active-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	onewire_gpio_sleep: onewire-gpio-sleep-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	rt1711h_int_n: rt1711h-int-n-state {
		pins = "gpio93";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	wcd_reset_n: wcd-reset-n-state {
		pins = "gpio92";
		function = "gpio";
		drive-strength = <16>;
		output-high;
	};

	aw87xxx_reset: aw87xxx-reset-state {
		pins = "gpio106";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	bq2589x_int_default: bq2589x-int-default-state {
		pins = "gpio105";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	/* GPIO66: BQ25890 USB D+/D- switch; downstream confirmed output-low idle */
	bq2589x_usb_switch_default: bq2589x-usb-switch-default-state {
		pins = "gpio66";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};
};


&remoteproc_adsp {
	firmware-name = "qcom/sm6225/XIAOMI/TAPAS/adsp.mdt";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6225/XIAOMI/TAPAS/cdsp.mdt";
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm6225/XIAOMI/TAPAS/modem.mdt";
	status = "okay";
};

&ipa {
	firmware-name = "qcom/sm6225/XIAOMI/TAPAS/ipa_fws.mdt";
	status = "okay";
};

&venus {
	status = "okay";
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm6125-regulators";

		/*
		 * S3/S4 is VDD_CX
		 * S5 is VDD_MX/WCSS_MX
		 */

		pm6125_s6: s6 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <1419000>;
		};

		pm6125_s7: s7 {
			regulator-min-microvolt = <1569000>;
			regulator-max-microvolt = <2040000>;
		};

		pm6125_s8: s8 {
			regulator-min-microvolt = <1060000>;
			regulator-max-microvolt = <1170000>;
		};

		pm6125_l1: l1 {
			regulator-min-microvolt = <950000>;
			regulator-max-microvolt = <1150000>;
		};

		pm6125_l4: l4 {
			regulator-min-microvolt = <720000>;
			regulator-max-microvolt = <1050000>;
		};

		pm6125_l5: l5 {
			regulator-min-microvolt = <1650000>;
			/* 2.96 V used to meet the SDHCI I/O voltage range */
			regulator-max-microvolt = <3050000>;
			regulator-allow-set-load;
			/* Broken hw, this one can't be turned off or SDHCI will break! */
			regulator-always-on;
		};

		pm6125_l6: l6 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		pm6125_l7: l7 {
			/* 1.2-1.3 V for the SDHCI I/O supply */
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1300000>;
			regulator-always-on;
		};

		pm6125_l8: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l10: l10 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1950000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l13: l13 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l14: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l17: l17 {
			regulator-min-microvolt = <1220000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l18: l18 {
			/* 1.104V-1.312V fixed @ 1.232V for DSIPHY */
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l19: l19 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l20: l20 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <3300000>;
		};

		pm6125_l21: l21 {
			regulator-min-microvolt = <1600000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l22: l22 {
			regulator-min-microvolt = <2950000>;
			/* 3.304V capped to 2.96V for SDHCI */
			regulator-max-microvolt = <3300000>;
			regulator-allow-set-load;
			/* Broken hw, this one can't be turned off or SDHCI will break! */
			regulator-always-on;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3400000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};
	};
};

&pm6125_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio5";
		function = "normal";
		power-source = <0>;
		bias-pull-up;
		input-enable;
	};
};

&pm6125_rtc {
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&sdc2_state_off {
	cd-pins {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&sdc2_state_on {
	cd-pins {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&sdhc_2 {
	pinctrl-0 = <&sdc2_state_on>;
	pinctrl-1 = <&sdc2_state_off>;
	pinctrl-names = "default", "sleep";

	cd-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
	bus-width = <4>;
	no-sdio;
	no-mmc;

	vmmc-supply = <&pm6125_l22>;
	vqmmc-supply = <&pm6125_l5>;

	status = "okay";
};

&sleep_clk {
	clock-frequency = <32764>;
};

&ufs_mem_hc {
	vcc-supply = <&pm6125_l24>;
	vcc-max-microamp = <800000>;
	vccq2-supply = <&pm6125_l11>;
	vccq2-max-microamp = <800000>;
	vdd-hba-supply = <&pm6125_l18>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-phy-max-microamp = <0x14ec4>;
	vdda-pll-supply = <&pm6125_l18>;
	status = "okay";
	vdda-pll-max-microamp = <0x477c>;
};

&usb {
	status = "okay";
	qcom,select-utmi-as-pipe-clk;
};

&usb_dwc3 {
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	dr_mode = "otg";
	usb-role-switch;

	ports {
		port@0 {
			usb_dwc3_hs: endpoint {
				remote-endpoint = <&typec_con_hs>;
			};
		};
	};
};

&usb_hsphy {
	vdd-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l12>;
	vdda-phy-dpdm-supply = <&pm6125_l15>;
	status = "okay";
};

&usb_qmpphy {
	vdda-phy-supply = <&pm6125_l4>;
	vdda-pll-supply = <&pm6125_l12>;
	status = "okay";
};

&wifi {
	vdd-0.8-cx-mx-supply = <&pm6125_l8>;
	vdd-1.8-xo-supply = <&pm6125_l16>;
	vdd-1.3-rfa-supply = <&pm6125_l17>;
	vdd-3.3-ch0-supply = <&pm6125_l23>;
	qcom,ath10k-calibration-variant = "tapas-gl";
	status = "okay";
};

&uart3 {
	pinctrl-0 = <&qup_uart3_4pin>;
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn3950-bt";

		vddio-supply = <&pm6125_l9>;
		vddxo-supply = <&pm6125_l16>;
		vddrf-supply = <&pm6125_l17>;
		vddch0-supply = <&pm6125_l23>;
		max-speed = <3200000>;
	};
};

&xo_board {
	clock-frequency = <19200000>;
};

&qupv3_id_0 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft3519", "focaltech,ft3518";
		reg = <0x38>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
		vcc-supply = <&touch_avdd>;
		iovcc-supply = <&pm6125_l9>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_active &ts_reset_active &ts_avdd_active>;
		touchscreen-maximum-contacts = <10>;
		touchscreen-size-x = <1350>;
		touchscreen-size-y = <3000>;
	};
};

&i2c1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	sm5602@71 {
		compatible = "sm,sm5602";
		reg = <0x00000071>;
		#io-channel-cells = <1>;
		sm,en_temp_ex;
		sm,en_batt_det;
		sm,iocv_man_mode;
		sm,misc = <0x00000800>;
		sm,aging_ctrl = <0x00000121>;
		sm,cycle_cfg = <0x00007000>;
		sm,rsns = <0x00000000>;
		sm,fg_irq_set = <0x000007ff>;
		sm,low_soc1 = <0x00000001>;
		sm,low_soc2 = <0x0000000f>;
		sm,v_l_alarm = <0x00000d48>;
		sm,v_h_alarm = <0x00001162>;
		sm,battery_table_num = <0x00000000>;
		sm,param_version = <0x00000006>;
		sm,t_l_alarm_in = <0x00000036>;
		sm,t_h_alarm_in = <0x00000001>;
		sm,t_l_alarm_ex = <0x0000d3d8>;
		sm,t_h_alarm_ex = <0x00009245>;
		sm,shutdown-delay-enable;
		sm,rtrace = <0x000007d0>;
		sm,soc_decimal_rate = <0x00000000 0x00000026 0x0000000a 0x00000023 0x00000014 0x00000021 0x0000001e 0x00000021 0x00000028 0x00000021 0x00000032 0x00000021 0x0000003c 0x00000021 0x00000046 0x0000001e 0x00000050 0x00000019 0x0000005a 0x00000014 0x0000005f 0x0000000a>;
		battery_params {
			/* Battery 0 */
			battery0,param_version = <0x00000001>;
			battery0,max_voltage_uv = <0x0043e6d0>;
			battery0,battery_type = <0x00001162 0x00000000 0x000026c9>;
			battery0,battery_table0 = <0x00001400 0x00001b3d 0x00001c5e 0x00001d3a 0x00001d80 0x00001d8d 0x00001d93 0x00001daa 0x00001dfa 0x00001e3e 0x00001e77 0x00001eb2 0x00001f09 0x00001f67 0x00001fb3 0x00001fe6 0x00002046 0x000020eb 0x000021a1 0x00002220 0x0000227a 0x00002319 0x00002360 0x000024cc>;
			battery0,battery_table1 = <0x00000000 0x00000068 0x000001f2 0x00000400 0x0000058a 0x00000798 0x00000aac 0x00000cba 0x00001367 0x00001b1a 0x000022cd 0x00002a80 0x00003234 0x00003756 0x000039e7 0x00003c78 0x0000419a 0x0000494e 0x00005101 0x00005623 0x000059bb 0x000060eb 0x00006400 0x000064e6>;
			battery0,battery_table2 = <0x0000141c 0x00001011 0x00000e0f 0x00000c0d 0x00000b0b 0x00000a0b 0x00000a0a 0x00000909>;
			battery0,alpha = <0x000000cc>;
			battery0,beta = <0x00000025>;
			battery0,rs = <0x0000005f>;
			battery0,rs_value = <0x00000050 0x0000010a 0x00003800 0x00000048>;
			battery0,vit_period = <0x0000315a>;
			battery0,volt_cal = <0x00008000>;
			battery0,mix_value = <0x00000003>;
			battery0,curr_offset = <0x00000000>;
			battery0,curr_slope = <0x00008080>;
			battery0,topoff_soc = <0x00000007 0x0000012c 0x00000064>;
			battery0,temp_std = <0x00000019>;
			battery0,temp_offset = <0x00000000 0x0000000b 0x00000001 0x00000000 0x00000008 0xffffffff>;
			battery0,temp_cal = <0x00000000 0x00000006 0x00000001 0x0000000b 0xffffffff 0x00000000 0x00000006 0x00000001 0x00000009 0x00000001>;
			battery0,ext_temp_cal = <0x00000000 0x00000002 0x00000001 0x00000002 0x00000001 0x00000001 0x00000002 0x00000003 0x00000002 0x00000003>;
