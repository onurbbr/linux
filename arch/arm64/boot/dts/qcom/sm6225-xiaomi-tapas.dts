	sc8551-charger@66 {
		compatible = "sc,sc8551-standalone";
		reg = <0x66>;
		interrupt-parent = <&tlmm>;
		interrupts = <84 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&sc8551_int_default>;
		sc,sc8551,bat-therm-disable = <0>;
		sc,sc8551,bus-therm-disable = <0>;
		sc,sc8551,bat-ovp-threshold = <4525>;
		sc,sc8551,bat-ovp-alarm-threshold = <4400>;
		sc,sc8551,bat-ocp-threshold = <8000>;
		sc,sc8551,bat-ocp-alarm-threshold = <7500>;
		sc,sc8551,bus-ovp-threshold = <12000>;
		sc,sc8551,bus-ovp-alarm-threshold = <11000>;
		sc,sc8551,bus-ocp-threshold = <3750>;
		sc,sc8551,bus-ocp-alarm-threshold = <3500>;
		sc,sc8551,bat-ucp-alarm-threshold = <2000>;
		sc,sc8551,bat-therm-threshold = <21>;
		sc,sc8551,bus-therm-threshold = <21>;
		sc,sc8551,die-therm-threshold = <125>;
		sc,sc8551,ac-ovp-threshold = <12>;
		sc,sc8551,sense-resistor-mohm = <5>;
		status = "okay";
	};

	bq25890: bq25890@6a {
		compatible = "ti,bq25890";
		reg = <0x6a>;

		interrupt-parent = <&tlmm>;
		interrupts = <105 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&bq2589x_int_default>;

		ti,charge-current = <2000000>;         /* 2 A */
		ti,battery-regulation-voltage = <4450000>; /* 4.45 V */
		ti,termination-current = <256000>;     /* 256 mA */
		ti,precharge-current = <128000>;       /* 128 mA */
		ti,minimum-sys-voltage = <3500000>;    /* 3.5 V */
		ti,boost-voltage = <5000000>;          /* 5 V OTG boost */
		ti,boost-max-current = <1500000>;      /* 1.5 A OTG */
		ti,input-current-sdp = <500000>;       /* SDP: 500 mA */
		ti,input-current-cdp = <1500000>;      /* CDP: 1.5 A */
		ti,input-current-dcp = <2000000>;      /* DCP: 2 A */
		ti,enable-auto-dpdm;
		ti,enable-termination;

		/* GPIO66: USB D+/D- switch (downstream confirmed) */
		usb-switch-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
		status = "okay";

		/*
		 * OTG boost output; consumed by rt1711h vbus-supply for
		 * host-mode VBUS.  No voltage constraints: the bq boost
		 * ops expose no voltage list, so fixed min/max would fail
		 * registration.
		 */
		usb_otg_vbus: usb-otg-vbus {
			regulator-name = "usb_otg_vbus";
		};
	};

	rt1711h@4e {
		compatible = "richtek,rt1711h";
		reg = <0x4e>;

		/*
		 * Host-mode VBUS comes from the BQ25890 boost output.
		 * Without this the TCPC cannot probe on mainline.
		 */
		vbus-supply = <&usb_otg_vbus>;

		interrupt-parent = <&tlmm>;
		interrupts = <93 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;

		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";

			source-pdos = <PDO_FIXED(5000, 900,
				PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE)>;
			/*
			 * 9 V max: the SC8551 divider path faults above 12 V
			 * (bus-ovp threshold), so 12 V/20 V must not be
			 * offered even though the adapter can do more.
			 * 9 V/3 A = 27 W is the fastest standard-PD mode.
			 */
			sink-pdos = <PDO_FIXED(5000, 3000,
					PDO_FIXED_USB_COMM | PDO_FIXED_DUAL_ROLE)
				     PDO_FIXED(9000, 3000, 0)>;
			op-sink-microwatt = <27000000>; /* 27 W */

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec_con_hs: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};
			};
		};
	};

	aw87xxx: aw87xxx_pa_59@59 {
		compatible = "awinic,aw87xxx_pa";
		dev_index = <0x00>;
		reg = <0x59>;
		reset-gpio = <&tlmm 106 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&aw87xxx_reset>;
		sound-name-prefix = "SpkrLeft";
		status = "okay";
		#sound-dai-cells = <0>;
	};
};

&lpass_audiocc {
	status = "okay";
};

&lpasscc {
	status = "okay";
};

&rxmacro {
	status = "okay";
};

&txmacro {
	status = "okay";
};

&vamacro {
	status = "okay";
};

&swr0 {
	status = "okay";

	pinctrl-0 = <&lpass_tx_swr_active>;
	pinctrl-names = "default";

	wcd937x_tx: codec@0,3 {
		compatible = "sdw20217010a00";
		reg = <0 3>;
		qcom,tx-port-mapping = <1 1 2 3>;
		qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3 4>;
	};
};

&swr1 {
	status = "okay";

	pinctrl-0 = <&lpass_rx_swr_active>;
	pinctrl-names = "default";

	wcd937x_rx: codec@0,4 {
		compatible = "sdw20217010a00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5>;
		qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
	};
};
